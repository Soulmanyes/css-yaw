#!/usr/bin/env bash
# Steam launch option wrapper for Source Yaw. Put it right before %command%:
#   sourceyaw-run %command%   (install.sh links it into ~/.local/bin; css-yaw-run,
#   its name before 1.2.0, still works)
# Rewrites yaws.cfg and the crosshair colours from the app's settings. For CS:S it
# also swaps the crosshair colour while the game runs: it turns KROSSHAIR on for
# the game and points it at our own image, so crosshair-maker's files are never
# touched. Momentum Mod sets its crosshair colour itself, so it only needs the apply.
# keep Steam's runtime libraries and overlay out of our own helpers; the game gets them back
GAME_PRELOAD=${LD_PRELOAD-}
GAME_LIBS=${LD_LIBRARY_PATH-}
unset LD_PRELOAD LD_LIBRARY_PATH

DIR="$(dirname "$(readlink -f "$0")")"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/sourceyaw"
OLD_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/css-yaw"
# settings from before the rename (done here because mkdir below would block it)
[ -d "$OLD_CFG" ] && [ ! -e "$CFG" ] && mv "$OLD_CFG" "$CFG"
RUNLOG="$CFG/run.log"
mkdir -p "$CFG"

# which game: Steam's command line carries AppId=<id> (its reaper wrapper)
GAME=css
for arg in "$@"; do
    case $arg in
        AppId=1802710) GAME=momentum ;;
    esac
done

{ date; echo "game: $GAME"; python3 "$DIR/yawcore.py" --apply "$GAME"; } > "$RUNLOG" 2>&1
# shellcheck source=/dev/null
. "$CFG/watch.env" 2>/dev/null

if [ "$GAME" = css ] && [ "${COLORS:-0}" = 1 ] && [ -n "${LOG:-}" ] && [ -f "$CFG/current.png" ]; then
    export KROSSHAIR=1 KROSSHAIR_IMG="$CFG/current.png"
    # started directly (not via a function) so $! is the watcher itself
    LOG="$LOG" "$DIR/yaw-watch.sh" >> "$RUNLOG" 2>&1 &
    WATCHER=$!
    trap 'kill "$WATCHER" 2>/dev/null; wait "$WATCHER" 2>/dev/null' EXIT
    trap 'exit 143' TERM INT HUP
fi

LD_PRELOAD=$GAME_PRELOAD LD_LIBRARY_PATH=$GAME_LIBS "$@"
