{
    "file_format_version": "1.0.0",
    "layer": {
        "name": "VK_LAYER_SOURCEYAW_overlay",
        "type": "GLOBAL",
        "api_version": "1.3.0",
        "library_path": "@LIBRARY@",
        "implementation_version": "1",
        "description": "Source Yaw strafe trainer overlay",
        "functions": {
            "vkGetInstanceProcAddr": "sourceyaw_GetInstanceProcAddr",
            "vkGetDeviceProcAddr": "sourceyaw_GetDeviceProcAddr"
        },
        "enable_environment": {
            "SOURCEYAW_OVERLAY": "1"
        },
        "disable_environment": {
            "DISABLE_SOURCEYAW_OVERLAY": "1"
        }
    }
}
